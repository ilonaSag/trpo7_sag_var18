<Window x:Class="trpo7_sag_var18.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:trpo7_sag_var18"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ListView Width="300" Height="290" ItemsSource="{Binding Packages}"  SelectionChanged="ListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Label Content="{Binding Id}"/>
                            <Label Content="{Binding TrackingNumber}"/>
                            <TextBlock Text="{Binding Recipient}"/>
                            <TextBlock Text="{Binding Weight}"/>
                            <TextBlock Text="{Binding Status}"/>
                            <TextBlock Text="{Binding IsDelivered}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" x:Name="FormPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Grid.Row="1">Трекномер</Label>
                <Label Grid.Row="2">Получатель</Label>
                <Label Grid.Row="3">Вес посылки</Label>
                <Label Grid.Row="4">Статус</Label>
                <Label Grid.Row="5">Отправление</Label>

                <TextBox Grid.Column="1" Grid.Row="1" Width="180" Height="20" Text="{Binding TrackingNumber, Mode=TwoWay}"></TextBox>
                <TextBox Grid.Column="1" Grid.Row="2" Width="180" Height="20" Text="{Binding Recipient, Mode=TwoWay}"></TextBox>
                <TextBox Grid.Column="1" Grid.Row="3" Width="180" Height="20" Text="{Binding Weight, Mode=TwoWay}"></TextBox>
                <TextBox Grid.Column="1" Grid.Row="4" Width="180" Height="20" Text="{Binding Status, Mode=TwoWay}"></TextBox>
                <CheckBox Grid.Column="1" Grid.Row="5" Width="180" Height="20" IsChecked="{Binding IsDelivered, Mode=TwoWay}"></CheckBox>
            </Grid>
        </StackPanel>
        <StackPanel Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="Button_Click">Отобразить все</Button>
            <StackPanel>
                <Label>Введите Id</Label>
               <TextBox Grid.Column="1" Width="100" Height="20" x:Name="IdTextBox"></TextBox>
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="GetOne_Click">Отобразить одно</Button>
            </StackPanel>
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="Add_Click">Создать запись</Button>
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="Put_Click">Изменить все</Button>
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="Patch_Click">Изменить</Button>
            <Button Grid.Row="1" Height="50" Width="100" Margin="10" Click="Delete_Click">Удалить</Button>
        </StackPanel>
    </Grid>
</Window>
